NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare R2 credentials. Server-side only: never prefix these with NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=xvideo-mvp
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# Private non-explicit test uploads only. Keep disabled by default.
R2_DEMO_UPLOADS_ENABLED=false
R2_UPLOADS_MODE=demo
# Required for production uploads: comma-separated exact origins, e.g. https://example.com
# Production uploads stay blocked when this is empty.
R2_ALLOWED_ORIGINS=
